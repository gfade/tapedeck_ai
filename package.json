{
  "name": "tapedeck",
  "private": true,
  "version": "0.1.0",
  "description": "Record, replay and fork pi agent sessions; analyze them as live objects in a Pharo image.",
  "type": "module",
  "workspaces": ["pi-tape", "runner"],
  "engines": { "node": ">=22.19" },
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "fixtures": "python3 fixtures/make_fixture_store.py fixtures/store",
    "test:image": "bash image/scripts/build-pharo13.sh",
    "test:agent-image": "node --test runner/integration/agent-image.test.ts",
    "demo": "bash demo/offline-demo.sh",
    "demo:local": "node runner/src/local-demo.ts",
    "demo:local:setup": "node runner/src/local-demo.ts --setup-only"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@earendil-works/pi-ai": "0.87.1",
    "typebox": "1.3.27",
    "typescript": "5.9.3",
    "@types/node": "22.20.4"
  }
}
